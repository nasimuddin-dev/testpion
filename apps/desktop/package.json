{
  "name": "@testpion/desktop",
  "productName": "TestPion",
  "version": "0.43.0",
  "private": true,
  "description": "TestPion desktop application",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "node scripts/dev.mjs --web",
    "build": "vite build && node scripts/build-main.mjs",
    "start": "electron .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "package": "npm run build && electron-builder --config electron-builder.yml --publish never",
    "package:dir": "npm run build && electron-builder --config electron-builder.yml --dir --publish never",
    "icons": "electron scripts/make-icons.cjs",
    "screenshots": "node scripts/build-main.mjs && vite build && node scripts/capture.cjs",
    "menu-icons": "electron scripts/make-menu-icons.cjs",
    "e2e": "node e2e/run-e2e.mjs"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@monaco-editor/react": "^4.7.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tailwindcss/vite": "^4.3.3",
    "@testpion/core": "0.43.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "dompurify": "^3.4.15",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "electron-updater": "^6.8.9",
    "esbuild": "^0.28.2",
    "graphql": "^16.14.2",
    "graphql-language-service": "^5.7.0",
    "jsonpath-plus": "^11.1.0",
    "lucide-react": "^1.48.0",
    "marked": "^14.0.0",
    "monaco-editor": "^0.57.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "vite": "^8.3.1",
    "yaml": "^2.9.1",
    "zustand": "^5.0.15"
  },
  "author": {
    "name": "TestPion contributors",
    "email": "noreply@github.com",
    "url": "https://github.com/nasimuddin-dev/testpion"
  },
  "homepage": "https://nasimuddin-dev.github.io/testpion/",
  "repository": {
    "type": "git",
    "url": "https://github.com/nasimuddin-dev/testpion.git"
  },
  "license": "MIT",
  "dependencies": {
    "@testpion/shared": "0.43.0",
    "qrcode": "^1.5.4"
  }
}
