{
  "info": {
    "_postman_id": "e2e-hawk-sample",
    "name": "Hawk sample (Postman)",
    "description": "A Postman request with Hawk auth, which TestPion does not have: it must import as No auth (never inherited) with a disabled placeholder header and a note.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{collectionToken}}", "type": "string" }] },
  "item": [
    {
      "name": "Health with Hawk",
      "request": {
        "auth": { "type": "hawk", "hawk": [{ "key": "authId", "value": "vet", "type": "string" }, { "key": "authKey", "value": "{{hawkKey}}", "type": "string" }, { "key": "algorithm", "value": "sha256", "type": "string" }] },
        "method": "GET",
        "header": [],
        "url": { "raw": "http://127.0.0.1:4010/health", "protocol": "http", "host": ["127", "0", "0", "1"], "port": "4010", "path": ["health"] }
      }
    }
  ]
}
