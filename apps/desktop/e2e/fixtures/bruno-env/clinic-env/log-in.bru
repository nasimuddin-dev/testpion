meta {
  name: Log in
  type: http
  seq: 1
}

post {
  url: {{process.env.BASE_URL}}/auth/token
  body: json
  auth: none
}

body:json {
  {
    "username": "vet",
    "password": "{{process.env.VET_PASSWORD}}"
  }
}

script:post-response {
  bru.setVar("token", res.getBody().access_token);
}

tests {
  test("logged in", function () {
    expect(res.getStatus()).to.equal(200);
  });
}
