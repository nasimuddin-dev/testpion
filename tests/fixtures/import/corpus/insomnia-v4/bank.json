{
  "_type": "export",
  "__export_format": 4,
  "__export_source": "insomnia.desktop.app:v10",
  "resources": [
    {
      "_id": "wrk_bank",
      "_type": "workspace",
      "name": "Bank API",
      "parentId": null
    },
    {
      "_id": "fld_bank_0",
      "_type": "request_group",
      "parentId": "wrk_bank",
      "name": "Accounts",
      "metaSortKey": 0,
      "authentication": {
        "type": "oauth2",
        "grantType": "client_credentials",
        "accessTokenUrl": "https://auth.bank.example.test/oauth/token",
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}",
        "scope": "accounts payments"
      }
    },
    {
      "_id": "req_bank_0_0",
      "_type": "request",
      "parentId": "fld_bank_0",
      "metaSortKey": 0,
      "name": "List accounts",
      "url": "{{ _.baseUrl }}/accounts",
      "method": "GET",
      "headers": [],
      "afterResponseScript": "insomnia.test(\"Status code is 200\", () => {\n  insomnia.expect(insomnia.response.code).to.eql(200);\n});"
    },
    {
      "_id": "req_bank_0_1",
      "_type": "request",
      "parentId": "fld_bank_0",
      "metaSortKey": 1,
      "name": "Get account",
      "url": "{{ _.baseUrl }}/accounts/{{ _.accountId }}",
      "method": "GET",
      "headers": []
    },
    {
      "_id": "req_bank_0_2",
      "_type": "request",
      "parentId": "fld_bank_0",
      "metaSortKey": 2,
      "name": "Get balances",
      "url": "{{ _.baseUrl }}/accounts/{{ _.accountId }}/balances",
      "method": "GET",
      "headers": [],
      "afterResponseScript": "insomnia.test(\"Status code is 200\", () => {\n  insomnia.expect(insomnia.response.code).to.eql(200);\n});"
    },
    {
      "_id": "req_bank_0_3",
      "_type": "request",
      "parentId": "fld_bank_0",
      "metaSortKey": 3,
      "name": "Get transactions",
      "url": "{{ _.baseUrl }}/accounts/{{ _.accountId }}/transactions",
      "method": "GET",
      "parameters": [
        {
          "name": "fromBookingDateTime",
          "value": "2026-01-01T00:00:00Z"
        },
        {
          "name": "limit",
          "value": "50"
        }
      ],
      "headers": []
    },
    {
      "_id": "req_bank_0_4",
      "_type": "request",
      "parentId": "fld_bank_0",
      "metaSortKey": 4,
      "name": "List standing orders",
      "url": "{{ _.baseUrl }}/accounts/{{ _.accountId }}/standing-orders",
      "method": "GET",
      "headers": []
    },
    {
      "_id": "fld_bank_1",
      "_type": "request_group",
      "parentId": "wrk_bank",
      "name": "Payments",
      "metaSortKey": 1
    },
    {
      "_id": "req_bank_1_0",
      "_type": "request",
      "parentId": "fld_bank_1",
      "metaSortKey": 0,
      "name": "Create a payment consent",
      "url": "{{ _.baseUrl }}/domestic-payment-consents",
      "method": "POST",
      "body": {
        "mimeType": "application/json",
        "text": "{\n  \"Data\": {\n    \"Initiation\": {\n      \"InstructionIdentification\": \"ACME412\",\n      \"InstructedAmount\": {\n        \"Amount\": \"165.88\",\n        \"Currency\": \"GBP\"\n      }\n    }\n  },\n  \"Risk\": {}\n}"
      },
      "headers": [
        {
          "name": "x-idempotency-key",
          "value": "{{$guid}}"
        },
        {
          "name": "x-fapi-financial-id",
          "value": "{{ _.orgId }}"
        }
      ],
      "afterResponseScript": "insomnia.test(\"Status code is 201\", () => {\n  insomnia.expect(insomnia.response.code).to.eql(201);\n});"
    },
    {
      "_id": "req_bank_1_1",
      "_type": "request",
      "parentId": "fld_bank_1",
      "metaSortKey": 1,
      "name": "Get a payment consent",
      "url": "{{ _.baseUrl }}/domestic-payment-consents/{{ _.consentId }}",
      "method": "GET",
      "headers": []
    },
    {
      "_id": "req_bank_1_2",
      "_type": "request",
      "parentId": "fld_bank_1",
      "metaSortKey": 2,
      "name": "Submit a payment",
      "url": "{{ _.baseUrl }}/domestic-payments",
      "method": "POST",
      "body": {
        "mimeType": "application/json",
        "text": "{\n  \"Data\": {\n    \"ConsentId\": \"{{ _.consentId }}\"\n  },\n  \"Risk\": {}\n}"
      },
      "headers": []
    },
    {
      "_id": "req_bank_1_3",
      "_type": "request",
      "parentId": "fld_bank_1",
      "metaSortKey": 3,
      "name": "Get a payment",
      "url": "{{ _.baseUrl }}/domestic-payments/{{ _.paymentId }}",
      "method": "GET",
      "headers": []
    },
    {
      "_id": "fld_bank_2",
      "_type": "request_group",
      "parentId": "wrk_bank",
      "name": "Funds",
      "metaSortKey": 2
    },
    {
      "_id": "req_bank_2_0",
      "_type": "request",
      "parentId": "fld_bank_2",
      "metaSortKey": 0,
      "name": "Confirm funds",
      "url": "{{ _.baseUrl }}/funds-confirmations",
      "method": "POST",
      "body": {
        "mimeType": "application/json",
        "text": "{\n  \"Data\": {\n    \"ConsentId\": \"{{ _.consentId }}\",\n    \"Reference\": \"Purchase01\",\n    \"InstructedAmount\": {\n      \"Amount\": \"20.00\",\n      \"Currency\": \"GBP\"\n    }\n  }\n}"
      },
      "headers": []
    },
    {
      "_id": "req_bank_2_1",
      "_type": "request",
      "parentId": "fld_bank_2",
      "metaSortKey": 1,
      "name": "Get funds consent",
      "url": "{{ _.baseUrl }}/funds-confirmation-consents/{{ _.consentId }}",
      "method": "GET",
      "headers": []
    },
    {
      "_id": "env_bank",
      "_type": "environment",
      "parentId": "wrk_bank",
      "name": "Base Environment",
      "data": {
        "baseUrl": "https://api.bank.example.test/open-banking/v3"
      }
    },
    {
