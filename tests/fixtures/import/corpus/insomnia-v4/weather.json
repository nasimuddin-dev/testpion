      "method": "GET",
      "parameters": [
        {
          "name": "lat",
          "value": "51.5"
        },
        {
          "name": "lon",
          "value": "-0.12"
        }
      ],
      "headers": []
    },
    {
      "_id": "req_weather_0_2",
