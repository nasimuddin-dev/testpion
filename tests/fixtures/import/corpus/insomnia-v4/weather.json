{
  "_type": "export",
  "__export_format": 4,
  "__export_source": "insomnia.desktop.app:v10",
  "resources": [
    {
      "_id": "wrk_weather",
      "_type": "workspace",
      "name": "Weather API",
      "parentId": null
    },
    {
      "_id": "fld_weather_0",
      "_type": "request_group",
      "parentId": "wrk_weather",
      "name": "Current",
      "metaSortKey": 0,
      "authentication": {
        "type": "apikey",
        "key": "appid",
        "value": "{{appid}}",
        "addTo": "queryParams"
      }
    },
    {
      "_id": "req_weather_0_0",
      "_type": "request",
      "parentId": "fld_weather_0",
      "metaSortKey": 0,
      "name": "Current weather by city",
      "url": "{{ _.baseUrl }}/weather",
      "method": "GET",
      "parameters": [
        {
          "name": "q",
          "value": "London,uk"
        },
        {
          "name": "units",
          "value": "metric"
        }
      ],
      "headers": [],
      "afterResponseScript": "insomnia.test(\"Status code is 200\", () => {\n  insomnia.expect(insomnia.response.code).to.eql(200);\n});"
    },
    {
      "_id": "req_weather_0_1",
      "_type": "request",
      "parentId": "fld_weather_0",
      "metaSortKey": 1,
