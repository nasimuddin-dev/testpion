{
  "meta": {
    "format": "httpie",
    "version": "1.0.0",
    "contentType": "collection",
    "docs": "https://httpie.io/r/export-docs",
    "source": "HTTPie for Desktop 2025.2.0"
  },
  "entry": {
    "name": "Weather API",
    "auth": {
      "type": "api-key",
      "credentials": {
        "name": "appid",
        "value": "{{appid}}",
        "in": "query"
      }
    },
    "requests": [],
    "collections": [
      {
        "name": "Current",
        "requests": [
          {
            "name": "Current weather by city",
            "method": "GET",
            "url": "{{baseUrl}}/weather",
            "queryParams": [
              {
                "name": "q",
                "value": "London,uk",
                "enabled": true
              },
              {
                "name": "units",
                "value": "metric",
                "enabled": true
              }
            ],
            "pathParams": [],
            "headers": [],
            "auth": {
              "type": "inherit"
            },
            "body": {}
          },
          {
            "name": "Current weather by coordinates",
            "method": "GET",
            "url": "{{baseUrl}}/weather",
            "queryParams": [
              {
                "name": "lat",
                "value": "51.5",
                "enabled": true
              },
              {
                "name": "lon",
                "value": "-0.12",
                "enabled": true
              }
            ],
            "pathParams": [],
            "headers": [],
            "auth": {
              "type": "inherit"
            },
            "body": {}
          },
          {
            "name": "Current weather by zip",
            "method": "GET",
            "url": "{{baseUrl}}/weather",
            "queryParams": [
              {
                "name": "zip",
                "value": "94040,us",
                "enabled": true
              }
            ],
            "pathParams": [],
            "headers": [],
            "auth": {
              "type": "inherit"
            },
            "body": {}
          }
        ]
      },
      {
        "name": "Forecast",
        "requests": [
          {
            "name": "5 day forecast",
            "method": "GET",
            "url": "{{baseUrl}}/forecast",
            "queryParams": [
              {
                "name": "q",
                "value": "Paris",
                "enabled": true
              },
              {
                "name": "cnt",
                "value": "40",
                "enabled": true
              }
            ],
            "pathParams": [],
            "headers": [],
            "auth": {
              "type": "inherit"
            },
            "body": {}
          },
          {
            "name": "Air pollution",
            "method": "GET",
            "url": "{{baseUrl}}/air_pollution",
            "queryParams": [
              {
                "name": "lat",
                "value": "50",
                "enabled": true
              },
              {
                "name": "lon",
                "value": "50",
                "enabled": true
              }
            ],
            "pathParams": [],
            "headers": [],
            "auth": {
              "type": "inherit"
            },
            "body": {}
          },
          {
            "name": "Weather alerts",
            "method": "GET",
            "url": "{{baseUrl}}/onecall",
            "queryParams": [
              {
                "name": "lat",
                "value": "33.44",
                "enabled": true
              },
              {
                "name": "lon",
                "value": "-94.04",
                "enabled": true
              },
              {
                "name": "exclude",
                "value": "minutely,hourly",
                "enabled": true
              }
            ],
            "pathParams": [],
            "headers": [],
            "auth": {
              "type": "inherit"
            },
            "body": {}
          }
        ]
      }
    ]
  }
}
