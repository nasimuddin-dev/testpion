          {
            "enabled": true,
            "name": "baseUrl",
            "value": "http://localhost:8080/v2"
          },
          {
            "enabled": true,
            "name": "apiKey",
            "value": "dev-key"
          }
        ]
      },
      {
        "model": "environment",
        "id": "ev_petstore_staging",
