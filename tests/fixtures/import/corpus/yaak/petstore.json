      {
        "model": "environment",
        "id": "ev_petstore_base",
        "workspaceId": "wk_petstore",
        "name": "Global",
        "base": true,
        "variables": [
          {
            "enabled": true,
            "name": "baseUrl",
            "value": "https://petstore.example.test/v2"
          }
        ]
      },
      {
        "model": "environment",
        "id": "ev_petstore_dev",
        "workspaceId": "wk_petstore",
