      {
        "model": "http_request",
        "id": "rq_clinic_9",
        "workspaceId": "wk_clinic",
        "folderId": "fl_clinic_2",
        "name": "List owners",
        "method": "GET",
        "url": "${[ baseUrl ]}/owners",
        "urlParameters": [],
        "headers": [],
        "bodyType": null,
