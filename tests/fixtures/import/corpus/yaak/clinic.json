        "url": "${[ baseUrl ]}/patients/:id/photo",
        "urlParameters": [
          {
            "enabled": true,
            "name": ":id",
            "value": "p-1"
          }
        ],
        "headers": [],
        "bodyType": "multipart/form-data",
        "body": {
          "form": [
            {
              "enabled": true,
              "name": "caption",
              "value": "At the beach"
            },
            {
              "enabled": true,
              "name": "photo",
              "file": "rex.png"
            }
          ]
        },
        "authenticationType": null,
        "authentication": {},
        "sortPriority": 5
      },
      {
        "model": "http_request",
        "id": "rq_clinic_6",
        "workspaceId": "wk_clinic",
        "folderId": "fl_clinic_1",
        "name": "List visits",
        "method": "GET",
        "url": "${[ baseUrl ]}/visits",
