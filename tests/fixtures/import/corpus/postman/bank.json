{
  "info": {
    "_postman_id": "pm-bank",
    "name": "Bank API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "oauth2",
    "oauth2": [
      {
        "key": "grant_type",
        "value": "client_credentials"
      },
      {
        "key": "accessTokenUrl",
        "value": "https://auth.bank.example.test/oauth/token"
      },
      {
        "key": "clientId",
        "value": "{{clientId}}"
      },
      {
        "key": "clientSecret",
        "value": "{{clientSecret}}"
      },
      {
        "key": "scope",
        "value": "accounts payments"
      }
    ]
  },
  "item": [
    {
      "name": "Accounts",
      "item": [
        {
          "name": "List accounts",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/accounts",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "accounts"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get account",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/accounts/{{accountId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "accounts",
                "{{accountId}}"
              ]
            }
          }
        },
        {
          "name": "Get balances",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/accounts/{{accountId}}/balances",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "accounts",
                "{{accountId}}",
                "balances"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get transactions",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/accounts/{{accountId}}/transactions?fromBookingDateTime=2026-01-01T00:00:00Z&limit=50",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "accounts",
                "{{accountId}}",
                "transactions"
              ],
              "query": [
                {
                  "key": "fromBookingDateTime",
                  "value": "2026-01-01T00:00:00Z"
                },
                {
                  "key": "limit",
                  "value": "50"
                }
              ]
            }
          }
        },
        {
          "name": "List standing orders",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/accounts/{{accountId}}/standing-orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "accounts",
                "{{accountId}}",
                "standing-orders"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Payments",
      "item": [
        {
          "name": "Create a payment consent",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "x-idempotency-key",
                "value": "{{$guid}}"
              },
              {
                "key": "x-fapi-financial-id",
                "value": "{{orgId}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"Data\": {\n    \"Initiation\": {\n      \"InstructionIdentification\": \"ACME412\",\n      \"InstructedAmount\": {\n        \"Amount\": \"165.88\",\n        \"Currency\": \"GBP\"\n      }\n    }\n  },\n  \"Risk\": {}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/domestic-payment-consents",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "domestic-payment-consents"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get a payment consent",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/domestic-payment-consents/{{consentId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "domestic-payment-consents",
                "{{consentId}}"
              ]
            }
          }
        },
        {
          "name": "Submit a payment",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"Data\": {\n    \"ConsentId\": \"{{consentId}}\"\n  },\n  \"Risk\": {}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/domestic-payments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "domestic-payments"
              ]
            }
          }
        },
        {
          "name": "Get a payment",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/domestic-payments/{{paymentId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "domestic-payments",
                "{{paymentId}}"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Funds",
      "item": [
        {
          "name": "Confirm funds",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"Data\": {\n    \"ConsentId\": \"{{consentId}}\",\n    \"Reference\": \"Purchase01\",\n    \"InstructedAmount\": {\n      \"Amount\": \"20.00\",\n      \"Currency\": \"GBP\"\n    }\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/funds-confirmations",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "funds-confirmations"
              ]
            }
          }
        },
        {
          "name": "Get funds consent",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/funds-confirmation-consents/{{consentId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "funds-confirmation-consents",
                "{{consentId}}"
              ]
            }
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://api.bank.example.test/open-banking/v3"
    }
  ]
}
