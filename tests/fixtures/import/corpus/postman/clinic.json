{
  "info": {
    "_postman_id": "pm-clinic",
    "name": "Vet Clinic",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "basic",
    "basic": [
      {
        "key": "username",
        "value": "{{user}}"
      },
      {
        "key": "password",
        "value": "{{password}}"
      }
    ]
  },
  "item": [
    {
      "name": "Patients",
      "item": [
        {
          "name": "List patients",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/patients?species=dog&limit=25",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "patients"
              ],
              "query": [
                {
                  "key": "species",
                  "value": "dog"
                },
                {
                  "key": "limit",
                  "value": "25"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Create a patient",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Rex\",\n  \"species\": \"dog\",\n  \"born\": \"2021-03-04\",\n  \"owner\": \"o-7\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/patients",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "patients"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get a patient",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/patients/:id",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "patients",
                ":id"
              ],
              "variable": [
                {
                  "key": "id",
                  "value": "p-1"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Update a patient",
          "request": {
            "method": "PATCH",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"weightKg\": 31.5\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/patients/:id",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "patients",
                ":id"
              ],
              "variable": [
                {
                  "key": "id",
                  "value": "p-1"
                }
              ]
            }
          }
        },
        {
          "name": "Upload a photo",
          "request": {
            "method": "PUT",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "caption",
                  "value": "At the beach",
                  "type": "text"
                },
                {
                  "key": "photo",
                  "type": "file",
                  "src": "rex.png"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/patients/:id/photo",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "patients",
                ":id",
                "photo"
              ],
              "variable": [
                {
                  "key": "id",
                  "value": "p-1"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Visits",
      "item": [
        {
          "name": "List visits",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/visits?patient=p-1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "visits"
              ],
              "query": [
                {
                  "key": "patient",
                  "value": "p-1"
                }
              ]
            }
          }
        },
        {
          "name": "Book a visit",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"patient\": \"p-1\",\n  \"at\": \"2026-05-04T09:30:00Z\",\n  \"reason\": \"vaccination\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/visits",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "visits"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Cancel a visit",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/visits/v-3",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "visits",
                "v-3"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Owners",
      "item": [
        {
          "name": "List owners",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/owners",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "owners"
              ]
            }
          }
        },
        {
          "name": "Create an owner",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ada\",\n  \"email\": \"ada@example.test\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/owners",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "owners"
              ]
            }
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://clinic.example.test/api"
    }
  ]
}
