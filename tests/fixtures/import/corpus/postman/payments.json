{
  "info": {
    "_postman_id": "pm-payments",
    "name": "Payments API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{secretKey}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Customers",
      "item": [
        {
          "name": "Create a customer",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "email",
                  "value": "jenny@example.test"
                },
                {
                  "key": "name",
                  "value": "Jenny Rosen"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/customers",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "customers"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Retrieve a customer",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/customers/cus_123",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "customers",
                "cus_123"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Update a customer",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "description",
                  "value": "VIP"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/customers/cus_123",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "customers",
                "cus_123"
              ]
            }
          }
        },
        {
          "name": "Delete a customer",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/customers/cus_123",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "customers",
                "cus_123"
              ]
            }
          }
        },
        {
          "name": "List all customers",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/customers?limit=10&starting_after=cus_100",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "customers"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "10"
                },
                {
                  "key": "starting_after",
                  "value": "cus_100"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Charges",
      "item": [
        {
          "name": "Create a charge",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "amount",
                  "value": "2000"
                },
                {
                  "key": "currency",
                  "value": "usd"
                },
                {
                  "key": "source",
                  "value": "tok_visa"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/charges",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "charges"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Retrieve a charge",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/charges/ch_123",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "charges",
                "ch_123"
              ]
            }
          }
        },
        {
          "name": "Capture a charge",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/charges/ch_123/capture",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "charges",
                "ch_123",
                "capture"
              ]
            }
          }
        },
        {
          "name": "List all charges",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/charges?customer=cus_123",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "charges"
              ],
              "query": [
                {
                  "key": "customer",
                  "value": "cus_123"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Refunds",
      "item": [
        {
          "name": "Create a refund",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "charge",
                  "value": "ch_123"
                },
                {
                  "key": "amount",
                  "value": "500"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/refunds",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "refunds"
              ]
            }
          }
        },
        {
          "name": "Retrieve a refund",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/refunds/re_123",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "refunds",
                "re_123"
              ]
            }
          }
        },
        {
          "name": "List all refunds",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/refunds?charge=ch_123",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "refunds"
              ],
              "query": [
                {
                  "key": "charge",
                  "value": "ch_123"
                }
              ]
            }
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://api.payments.example.test/v1"
    }
  ]
}
