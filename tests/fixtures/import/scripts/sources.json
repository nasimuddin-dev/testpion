{
  "postman": [
    { "name": "status code test (docs)", "source": "pm.test(\"Status code is 200\", function () {\n    pm.response.to.have.status(200);\n});" },
    { "name": "response time (docs)", "source": "pm.test(\"Response time is less than 200ms\", function () {\n    pm.expect(pm.response.responseTime).to.be.below(200);\n});" },
    { "name": "json body field", "source": "const jsonData = pm.response.json();\npm.test(\"Your test name\", function () {\n    pm.expect(jsonData.value).to.eql(100);\n});" },
    { "name": "save token to environment", "source": "var jsonData = pm.response.json();\npm.environment.set(\"token\", jsonData.token);" },
    { "name": "collection variable from header", "source": "pm.collectionVariables.set('requestId', pm.response.headers.get('X-Request-Id'));" },
    { "name": "global variable round trip", "source": "pm.globals.set('count', 1);\nconsole.log(pm.globals.get('count'));" },
    { "name": "pre-request timestamp", "source": "pm.variables.set('now', new Date().toISOString());" },
    { "name": "set next request", "source": "if (pm.response.code === 200) {\n    pm.execution.setNextRequest('Get orders');\n} else {\n    pm.execution.setNextRequest(null);\n}" },
    { "name": "sendRequest with callback", "source": "pm.sendRequest('https://example.test/health', function (err, res) {\n    pm.test('health ok', function () {\n        pm.expect(err).to.equal(null);\n    });\n});" },
    { "name": "own pm as a parameter", "source": "function check(pm) {\n    return pm.value > 1;\n}\npm.test('uses the global', function () {\n    pm.expect(check({ value: 2 })).to.be.true;\n});" },
    { "name": "pm in strings and comments stays", "source": "// pm.environment.set in a comment\nconsole.log('pm.response.json() in a string');\nconst re = /pm\\.test/;\npm.test('x', () => pm.expect(re.test('pm.test')).to.be.true);" },
    { "name": "template literal", "source": "console.log(`code ${pm.response.code} for ${pm.info.requestName}`);" },
    { "name": "property named pm is not the global", "source": "const holder = { pm: 1 };\nconsole.log(holder.pm);\npm.variables.set('a', holder.pm);" },
    { "name": "shorthand property", "source": "const ctx = { pm, other: 1 };\nctx.pm.variables.set('shorthand', 'yes');" },
    { "name": "cookies and info", "source": "pm.test('has cookie', function () {\n    pm.expect(pm.cookies.has('session')).to.be.true;\n});\nconsole.log(pm.info.requestName, pm.info.eventName);" },
    { "name": "iteration data", "source": "const user = pm.iterationData.get('user');\npm.variables.set('currentUser', user);" },
    { "name": "visualizer", "source": "pm.visualizer.set('<p>{{name}}</p>', { name: pm.response.json().name });" },
    { "name": "chai chain assertions", "source": "pm.test('body', function () {\n    pm.response.to.have.header('Content-Type');\n    pm.response.to.be.json;\n    pm.expect(pm.response.json()).to.have.property('id');\n});" },
    { "name": "legacy postman.* environment", "source": "postman.setEnvironmentVariable('token', JSON.parse(responseBody).token);\nvar saved = postman.getEnvironmentVariable('token');\npostman.clearEnvironmentVariable('stale');" },
    { "name": "legacy globals", "source": "postman.setGlobalVariable('g', 1);\npostman.clearGlobalVariable('old');\npostman.setNextRequest('Next');" },
    { "name": "legacy tests object", "source": "tests[\"Status code is 200\"] = responseCode.code === 200;\ntests[\"Body has id\"] = JSON.parse(responseBody).id === 7;" },
    { "name": "legacy response helpers", "source": "var data = JSON.parse(responseBody);\nconsole.log(responseTime, responseCode.name, postman.getResponseHeader('Content-Type'));" },
    { "name": "environment name", "source": "console.log(pm.environment.name);" },
    { "name": "async await", "source": "async function run() {\n    const res = await pm.sendRequest('https://example.test/a');\n    pm.variables.set('a', res.code);\n}\nrun();" },
    { "name": "try catch with err", "source": "try {\n    pm.response.json();\n} catch (pm) {\n    console.log(pm.message);\n}" },
    { "name": "Postman API without equivalent", "source": "const rows = pm.datasets.query('select 1');\nconsole.log(rows);" },
    { "name": "lodash and crypto modules", "source": "const _ = require('lodash');\nconst sha = require('crypto-js').SHA256(pm.variables.get('v'));\npm.variables.set('sha', sha.toString());" },
    { "name": "bracket access", "source": "pm['environment'].set('b', 2);" },
    { "name": "does not parse", "source": "pm.test('x', function () { " },
    { "name": "no postman API at all", "source": "const total = [1, 2, 3].reduce((a, b) => a + b, 0);\nconsole.log(total);" }
  ],
  "insomnia": [
    { "name": "environment set", "source": "insomnia.environment.set('token', 'abc');" },
    { "name": "test with expect", "source": "insomnia.test('status', () => {\n    insomnia.expect(insomnia.response.code).to.eql(200);\n});" },
    { "name": "response json", "source": "const body = insomnia.response.json();\ninsomnia.environment.set('id', body.id);" },
    { "name": "base environment", "source": "insomnia.baseEnvironment.set('shared', 1);\nconsole.log(insomnia.collectionVariables.get('shared'));" },
    { "name": "variables and info", "source": "insomnia.variables.set('v', 1);\nconsole.log(insomnia.info.requestName);" },
    { "name": "request header", "source": "insomnia.request.headers.upsert({ key: 'X-A', value: '1' });" },
    { "name": "parent folders", "source": "const folder = insomnia.parentFolders.get('Auth');\nconsole.log(folder);" },
    { "name": "request auth update", "source": "insomnia.request.auth.update({ token: 'x' }, 'bearer');" },
    { "name": "plain javascript", "source": "const ids = [1, 2];\nfor (const id of ids) console.log(id);" },
    { "name": "string and comment mention", "source": "// insomnia.environment is documented\nconsole.log('insomnia.environment');" },
    { "name": "local insomnia variable", "source": "const insomnia = { fake: true };\nconsole.log(insomnia.fake);" }
  ],
  "bruno": [
    { "name": "env var round trip", "source": "const t = bru.getEnvVar('token');\nbru.setEnvVar('copy', t);" },
    { "name": "runtime variables", "source": "bru.setVar('count', 1);\nif (bru.getVar('count') > 0) console.log('positive');" },
    { "name": "next request", "source": "bru.setNextRequest('Get user');\nbru.runner.skipRequest();" },
    { "name": "stop execution", "source": "if (res.status === 500) {\n  bru.runner.stopExecution();\n}" },
    { "name": "env name and request name", "source": "console.log(bru.getEnvName(), bru.getRequestName());" },
    { "name": "interpolate", "source": "const url = bru.interpolate('{{host}}/users');\nconsole.log(url);" },
    { "name": "process env and secret", "source": "const key = bru.getProcessEnv('API_KEY');\nconst secret = bru.getSecretVar('s');" },
    { "name": "collection and folder variables", "source": "const a = bru.getCollectionVar('a');\nconst b = bru.getFolderVar('b');\nconst c = bru.getRequestVar('c');" },
    { "name": "global env var", "source": "bru.setGlobalEnvVar('g', 1);\nbru.getGlobalEnvVar('g');" },
    { "name": "sleep stays", "source": "await bru.sleep(10);" },
    { "name": "sendRequest has no equivalent", "source": "const r = await bru.sendRequest({ url: 'https://example.test' });" },
    { "name": "cookies have no equivalent", "source": "const jar = bru.cookies.jar();\njar.clear();" },
    { "name": "res and test stay on the shim", "source": "test('ok', function () {\n  expect(res.status).to.equal(200);\n  expect(res.getBody().id).to.equal(1);\n});" },
    { "name": "bru in strings and comments", "source": "// bru.getVar in a comment stays\nconsole.log('bru.setEnvVar in a string stays');\nbru.setVar('x', 1);" },
    { "name": "local bru object", "source": "const bru = { getVar: () => 1 };\nbru.getVar('x');" }
  ]
