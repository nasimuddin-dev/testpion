{
  "schemaVersion": "1.0",
  "id": "soap",
  "name": "SOAP services",
  "description": "A public SOAP service, imported from its WSDL (Import ▸ link: https://www.dataaccess.com/webservicesserver/NumberConversion.wso?WSDL). Each operation has its SOAPAction and an envelope built from the XML Schema; the tests read the XML reply with xml2Json.",
  "variables": [
    {
      "key": "baseUrl",
      "value": "https://www.dataaccess.com/webservicesserver/NumberConversion.wso",
      "enabled": true
    }
  ],
  "items": [
    {
      "kind": "folder",
      "id": "fld-muo41e67914ad1354a",
      "name": "NumberConversion · NumberConversionSoap",
      "items": [
        {
          "kind": "http",
          "id": "soap-1",
          "name": "NumberToWords",
          "description": "Returns the word corresponding to the positive number passed as parameter. Limited to quadrillions.",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}",
            "params": [],
            "headers": [
              {
                "key": "Content-Type",
                "value": "text/xml; charset=utf-8",
                "enabled": true
              },
              {
                "key": "SOAPAction",
                "value": "\"\"",
                "enabled": true
              }
            ],
            "body": {
              "type": "xml",
              "content": "<soap:Envelope xmlns:soap=\"http://schemas.xmlsoap.org/soap/envelope/\" xmlns:tns=\"http://www.dataaccess.com/webservicesserver/\">\n  <soap:Header/>\n  <soap:Body>\n    <tns:NumberToWords>\n      <tns:ubiNum>42</tns:ubiNum>\n    </tns:NumberToWords>\n  </soap:Body>\n</soap:Envelope>"
            },
            "auth": {
              "type": "inherit"
            }
          },
          "assertions": [
            {
              "type": "status",
              "expected": 200
            }
          ],
          "testScript": "// the reply is XML: xml2Json turns it into an object\nconst reply = xml2Json(tp.response.text());\nconst body = reply['soap:Envelope']['soap:Body'];\nconst words = body['m:NumberToWordsResponse']['m:NumberToWordsResult'];\ntp.test('42 in words', () => tp.expect(words.trim()).to.equal('forty two'));"
        },
        {
          "kind": "http",
          "id": "soap-2",
          "name": "NumberToDollars",
          "description": "Returns the non-zero dollar amount of the passed number.",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}",
            "params": [],
            "headers": [
              {
                "key": "Content-Type",
                "value": "text/xml; charset=utf-8",
                "enabled": true
              },
              {
                "key": "SOAPAction",
                "value": "\"\"",
                "enabled": true
              }
            ],
            "body": {
              "type": "xml",
              "content": "<soap:Envelope xmlns:soap=\"http://schemas.xmlsoap.org/soap/envelope/\" xmlns:tns=\"http://www.dataaccess.com/webservicesserver/\">\n  <soap:Header/>\n  <soap:Body>\n    <tns:NumberToDollars>\n      <tns:dNum>12.5</tns:dNum>\n    </tns:NumberToDollars>\n  </soap:Body>\n</soap:Envelope>"
            },
            "auth": {
              "type": "inherit"
            }
          },
          "assertions": [
            {
              "type": "status",
              "expected": 200
            }
          ],
          "testScript": "tp.test('dollars and cents', () => tp.expect(tp.response.text()).to.include('twelve dollars and fifty cents'));"
        }
      ]
    },
