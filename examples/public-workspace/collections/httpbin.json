{
  "schemaVersion": "1.0",
  "id": "httpbin",
  "name": "HTTP basics (httpbin)",
  "description": "Requests against [httpbin.org](https://httpbin.org), a free service that echoes back what you send. Use it to see how methods, parameters, headers, bodies, authentication, cookies, redirects and status codes work.\n\nSelect the **Public APIs** environment, open a request and press **Send**, or run the whole collection (right-click ▸ **Run collection**). Each request has assertions and a test script, so a run shows passed and failed checks.",
  "variables": [],
  "items": [
    {
      "kind": "folder",
      "id": "hb-basics",
      "name": "Requests & responses",
      "items": [
        {
          "kind": "http",
          "id": "hb-get",
          "name": "GET with query parameters",
          "description": "httpbin returns the query parameters under `args`.",
          "request": {
            "method": "GET",
            "url": "{{httpbin}}/get",
            "params": [
              {
                "key": "search",
                "value": "testpion",
                "enabled": true
              },
              {
                "key": "page",
                "value": "1",
                "enabled": true
              }
            ],
            "headers": [
              {
                "key": "Accept",
                "value": "application/json",
                "enabled": true
              }
            ]
          },
          "assertions": [
            {
              "type": "status",
              "expected": 200
            },
            {
              "type": "equals",
              "path": "$.args.search",
              "expected": "testpion"
            },
            {
              "type": "latency",
              "max": 5000
            }
          ],
          "testScript": "tp.test('echoes the page parameter', () => {\n  tp.expect(tp.response.json().args.page).to.eql('1');\n});"
        },
        {
          "kind": "http",
          "id": "hb-post-json",
          "name": "POST a JSON body",
          "request": {
            "method": "POST",
            "url": "{{httpbin}}/post",
            "headers": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "enabled": true
              }
            ],
            "body": {
              "type": "json",
              "content": "{\n  \"name\": \"Biscuit\",\n  \"species\": \"dog\",\n  \"sentBy\": \"{{appName}}\",\n  \"id\": \"{{$guid}}\",\n  \"at\": \"{{$isoTimestamp}}\"\n}"
            }
          },
          "assertions": [
            {
              "type": "status",
              "expected": 200
            },
            {
              "type": "equals",
              "path": "$.json.name",
              "expected": "Biscuit"
            },
            {
              "type": "equals",
              "path": "$.json.sentBy",
              "expected": "TestPion"
            },
            {
              "type": "header",
              "header": "content-type",
              "expected": "application/json"
            }
          ]
        },
        {
          "kind": "http",
          "id": "hb-post-form",
          "name": "POST a form",
          "request": {
            "method": "POST",
            "url": "{{httpbin}}/post",
            "body": {
              "type": "form-urlencoded",
              "fields": [
                {
                  "key": "customer",
                  "value": "Ada",
                  "enabled": true
                },
                {
                  "key": "size",
                  "value": "large",
                  "enabled": true
                }
              ]
            }
          },
          "assertions": [
            {
              "type": "status",
              "expected": 200
            },
            {
              "type": "equals",
              "path": "$.form.customer",
              "expected": "Ada"
            }
          ]
        },
        {
          "kind": "http",
          "id": "hb-headers",
          "name": "Custom headers",
          "request": {
            "method": "GET",
            "url": "{{httpbin}}/headers",
            "headers": [
              {
                "key": "X-Request-Source",
                "value": "{{appName}}",
                "enabled": true
              },
              {
                "key": "X-Correlation-Id",
                "value": "{{$guid}}",
                "enabled": true
              }
            ]
          },
          "assertions": [
            {
              "type": "status",
              "expected": 200
            },
            {
              "type": "equals",
              "path": "$.headers.X-Request-Source",
              "expected": "TestPion"
            }
          ]
        },
        {
          "kind": "http",
          "id": "hb-status-404",
          "name": "Expect a 404",
          "description": "A negative test: the assertion expects 404, so the request passes when the server says Not Found.",
          "request": {
            "method": "GET",
            "url": "{{httpbin}}/status/404"
          },
          "assertions": [
            {
              "type": "status",
              "expected": 404
            }
          ]
        },
        {
          "kind": "http",
          "id": "hb-delay",
          "name": "Slow response (1 s) with a time limit",
          "request": {
            "method": "GET",
            "url": "{{httpbin}}/delay/1"
          },
          "assertions": [
            {
              "type": "status",
              "expected": 200
            },
            {
              "type": "latency",
              "max": 8000
            }
          ],
          "testScript": "tp.test('took at least a second', () => tp.expect(tp.response.responseTime).to.be.above(900));"
        },
        {
          "kind": "http",
          "id": "hb-redirect",
          "name": "Follows redirects",
          "request": {
            "method": "GET",
            "url": "{{httpbin}}/redirect/2"
          },
          "assertions": [
            {
              "type": "status",
              "expected": 200
            },
            {
              "type": "contains",
              "path": "$.url",
              "expected": "/get"
            }
          ]
        },
        {
          "kind": "http",
          "id": "hb-xml",
          "name": "XML response",
          "request": {
            "method": "GET",
            "url": "{{httpbin}}/xml"
          },
          "assertions": [
            {
              "type": "status",
              "expected": 200
            },
            {
              "type": "header",
              "header": "content-type",
              "expected": "xml"
            },
            {
              "type": "contains",
              "expected": "slideshow"
            }
          ],
          "testScript": "// xml2Json turns XML (SOAP too) into an object: attributes under \"$\"\nconst doc = xml2Json(tp.response.text());\ntp.test('slideshow title', () => tp.expect(doc.slideshow.$.title).to.equal('Sample Slide Show'));\ntp.test('two slides', () => tp.expect(doc.slideshow.slide).to.have.lengthOf(2));"
        },
        {
          "kind": "http",
          "id": "hb-image",
          "name": "Image response",
          "request": {
            "method": "GET",
            "url": "{{httpbin}}/image/png"
          },
          "assertions": [
            {
              "type": "status",
              "expected": 200
            },
            {
              "type": "header",
              "header": "content-type",
              "expected": "image/png"
            }
          ]
        },
        {
          "kind": "http",
          "id": "hb-uuid-schema",
          "name": "JSON Schema check",
          "request": {
            "method": "GET",
            "url": "{{httpbin}}/uuid"
          },
          "assertions": [
            {
              "type": "status",
              "expected": 200
            },
            {
              "type": "json-schema",
              "schema": {
                "type": "object",
                "required": [
                  "uuid"
                ],
                "properties": {
                  "uuid": {
                    "type": "string",
                    "pattern": "^[0-9a-f-]{36}$"
                  }
                }
              }
            }
          ]
        }
      ]
    },
    {
      "kind": "folder",
      "id": "hb-auth",
      "name": "Authentication",
      "items": [
        {
          "kind": "http",
          "id": "hb-basic",
          "name": "Basic auth",
          "request": {
            "method": "GET",
            "url": "{{httpbin}}/basic-auth/{{basicUser}}/{{basicPassword}}",
            "auth": {
              "type": "basic",
              "username": "{{basicUser}}",
              "password": "{{basicPassword}}"
            }
          },
          "assertions": [
            {
              "type": "status",
              "expected": 200
            },
            {
              "type": "equals",
              "path": "$.authenticated",
              "expected": true
            }
          ]
        },
        {
          "kind": "http",
          "id": "hb-basic-wrong",
          "name": "Basic auth with the wrong password",
          "request": {
            "method": "GET",
            "url": "{{httpbin}}/basic-auth/{{basicUser}}/{{basicPassword}}",
            "auth": {
              "type": "basic",
              "username": "{{basicUser}}",
              "password": "not-it"
            }
          },
          "assertions": [
            {
              "type": "status",
              "expected": 401
            }
          ]
        },
        {
          "kind": "http",
          "id": "hb-bearer",
          "name": "Bearer token",
          "request": {
            "method": "GET",
            "url": "{{httpbin}}/bearer",
            "auth": {
              "type": "bearer",
              "token": "{{demoToken}}"
            }
          },
          "assertions": [
            {
              "type": "status",
              "expected": 200
            },
            {
              "type": "equals",
              "path": "$.token",
              "expected": "demo-token-123"
            }
          ]
        },
        {
          "kind": "http",
          "id": "hb-digest",
          "name": "Digest auth",
          "request": {
            "method": "GET",
            "url": "{{httpbin}}/digest-auth/auth/{{basicUser}}/{{basicPassword}}",
            "auth": {
              "type": "digest",
              "username": "{{basicUser}}",
              "password": "{{basicPassword}}"
            }
          },
          "assertions": [
            {
              "type": "status",
              "expected": 200
            },
            {
              "type": "equals",
              "path": "$.user",
              "expected": "testpion"
            }
          ]
        },
        {
          "kind": "http",
          "id": "hb-apikey",
          "name": "API key in a header",
          "request": {
            "method": "GET",
            "url": "{{httpbin}}/headers",
            "auth": {
              "type": "apiKey",
              "key": "X-API-Key",
              "value": "{{demoToken}}",
              "in": "header"
            }
          },
          "assertions": [
            {
              "type": "status",
              "expected": 200
            },
            {
              "type": "equals",
              "path": "$.headers.X-Api-Key",
              "expected": "demo-token-123"
            }
          ]
        }
      ]
    },
    {
      "kind": "folder",
      "id": "hb-cookies",
      "name": "Cookies",
      "items": [
        {
          "kind": "http",
          "id": "hb-cookie-set",
          "name": "Server sets a cookie",
          "description": "The response sets `flavour=chocolate`; the cookie jar keeps it for the next request (see **Cookies** in the response and the Cookies manager).",
          "request": {
            "method": "GET",
            "url": "{{httpbin}}/cookies/set?flavour=chocolate"
          },
          "assertions": [
            {
              "type": "status",
              "expected": 200
            }
          ]
        },
        {
          "kind": "http",
          "id": "hb-cookie-read",
          "name": "Cookie is sent back",
          "request": {
            "method": "GET",
            "url": "{{httpbin}}/cookies"
          },
          "assertions": [
            {
              "type": "status",
              "expected": 200
            },
            {
              "type": "equals",
              "path": "$.cookies.flavour",
              "expected": "chocolate"
            }
          ]
        }
      ]
    }
  ]
}
